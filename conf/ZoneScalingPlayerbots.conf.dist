###############################################################################
# Playerbot Zone Scaling Module
###############################################################################

#------------------------------------------------------------------------------
# Generelle indstillinger
#------------------------------------------------------------------------------
ZoneScaling.Enable = 1

# Mobs skalerer aldrig under dette level (global bundgrænse).
ZoneScaling.MinLevel = 1

# Guards ligger dette antal levels over den skalerede baseline (spillerens
# level, evt. begrænset af zonens/area'ets MinLevel), før resultatet clampes
# af zonens/area'ets MaxLevel.
ZoneScaling.GuardLevelOffset = 12

# Skal raid-mobs skaleres yderligere efter antal spillere/playerbots i raidet?
ZoneScaling.RaidScalingEnable = 1
# Ekstra scaling pr. spiller/playerbot i raidet (0.02 = 2% pr. medlem).
ZoneScaling.RaidSizePerPlayerMult = 0.02

# HP-scaling er sammensat pr. level (0.05 = 5% ekstra af den aktuelle HP pr. level).
# Damage og armor skaleres lineært pr. level forskel.
ZoneScaling.HPPerLevelDiff = 0.05
ZoneScaling.DmgPerLevelDiff = 0.05
ZoneScaling.ArmorPerLevelDiff = 0.05

# Lægges til spillerens level FØR resultatet clampes til zonens/area'ets
# MinLevel/MaxLevel. +1 gør mobs ét level sværere end spilleren, -1 gør dem
# ét level lettere. Kan overstyres pr. zone/area (se ZoneScaling.Zone.<id>.LevelOffset
# / ZoneScaling.Area.<id>.LevelOffset nedenfor) - fx til at gøre kun dungeons
# lidt hårdere uden at røre resten af verdenen.
ZoneScaling.LevelOffset = 0

# Udled automatisk MinLevel/MaxLevel for konfigurerede zoner/areas fra
# quest_template. Når aktiv overstyrer dette manuelle værdier, hvis der findes
# quest-data. En zone/area kan fravælge autoskalering med dens lokale
# Zone/Area.<id>.QuestLevelAutoScale = 0. Areas mappes til deres parent-zone,
# da quests normalt er sorteret pr. zone og ikke pr. subzone/area.
ZoneScaling.QuestLevelAutoScale = 1

# Default maksimum mob-level for zoner/areas uden egen MaxLevel. 255 = ingen grænse.
ZoneScaling.Default.MaxLevel = 80

# Rund skalerings-målet ned til nærmeste multiplum af dette antal levels, for at
# undgå unødig re-scaling når en spiller ligger lige på grænsen. 1 = slået fra.
ZoneScaling.LevelBand = 1

# Hvor ofte (sekunder) en creature, der IKKE er i kamp, må tjekkes igen og evt.
# re-skaleres til den nærmeste spiller. 0 undgår at idle-creatures skifter level,
# når spillere med forskellige levels bevæger sig rundt. Combat-entry skalerer
# stadig til den faktiske modstander, når creature går i kamp.
ZoneScaling.RescaleIntervalSec = 0

# Dungeons: normale 5-mands dungeons låses til ét level for hele instancen,
# beregnet når den første creature skaleres: højeste level blandt spillere/bots
# i instancen og i deres gruppe, plus zonens LevelOffset, inden for zonens
# MinLevel/MaxLevel. Dungeons bruger altid de manuelle MinLevel/MaxLevel
# (QuestLevelAutoScale ignoreres for dem). Heroic-dungeons og raids skaleres
# ikke på level; RaidScalingEnable gælder stadig for raids.
# Antal ekstra levels dungeon-bosser får oven i instance-levelet.
ZoneScaling.DungeonBossLevelOffset = 2

# Kommasepareret liste af creature entries, der aldrig skaleres. Standard er
# dyrene fra hunter-questen "Taming the Beast", da taming rods kun virker på
# dyr op til et fast level.
ZoneScaling.ExcludeCreatureEntries = 1126,1196,1201,1996,1998,2043,2956,2959,2970,3099,3107,3126,15650,15652,16353,17203,17217,17374


#------------------------------------------------------------------------------
# Area/subzone scaling
# Area-indstillinger har prioritet over zone-indstillinger for den samme spiller.
#------------------------------------------------------------------------------
ZoneScaling.AreaIds = 209,271,465,722,1537,1637,2017,2057,2118,2367,2557,2677,3456,3457,3507,3508,3517,3520,3606,3607,3636,3646,3648,3679,3680,3685,3688,3707,3708,3709,3710,3713,3714,3715,3716,3717,3742,3744,3745,3748,3749,3754,3789,3790,3791,3836,3845,3847,3848,3849,3852,3880,3893,3935,3938,3944,3959,3973,3974,3975,3976,3977,3978,3980,3999,4009,4128,4157,4221,4272,4405,4520

# Kun de areas, der afviger fra defaultintervallet (MinLevel=1 / MaxLevel=80),
# er listet nedenfor. Alle andre areas i ZoneScaling.AreaIds ovenfor bruger
# stiltiende default-intervallet.

ZoneScaling.Area.271.MinLevel = 20
ZoneScaling.Area.271.MaxLevel = 30
ZoneScaling.Area.465.MinLevel = 15
ZoneScaling.Area.465.MaxLevel = 30
ZoneScaling.Area.2118.MaxLevel = 10
