###############################################################################
# Playerbot Zone Scaling Module
#
# Mobs skaleres til spilleren/botten de kæmper mod (eller den nærmeste spiller),
# inden for zonens level-interval. Intervallet kommer fra quest-data, medmindre
# zonen har egne MinLevel/MaxLevel nedenfor.
#
# OBS: AzerothCore kan ikke læse kommentarer på samme linje som en værdi.
# Skriv altid kommentarer på deres egen linje, ellers ignoreres værdien.
###############################################################################

#------------------------------------------------------------------------------
# Generelt
#------------------------------------------------------------------------------
ZoneScaling.Enable = 1

# Laveste level en mob nogensinde skaleres til.
ZoneScaling.MinLevel = 1

# Max level for zoner uden eget interval og uden quest-data. 255 = ingen grænse.
ZoneScaling.Default.MaxLevel = 80

# Lægges til spillerens level, før zonens interval anvendes (+1 = sværere).
ZoneScaling.LevelOffset = 0

# Guards ligger dette antal levels over mobs i samme zone.
ZoneScaling.GuardLevelOffset = 12

# Stat-scaling pr. level. HP sammensættes pr. level, damage og armor er lineære.
ZoneScaling.HPPerLevelDiff = 0.05
ZoneScaling.DmgPerLevelDiff = 0.05
ZoneScaling.ArmorPerLevelDiff = 0.05

# Udled zoners level-interval fra quest_template. Zoner med egne
# MinLevel/MaxLevel nedenfor bruger altid dem i stedet.
ZoneScaling.QuestLevelAutoScale = 1

# Rund målet ned til et multiplum af dette antal levels. 1 = slået fra.
ZoneScaling.LevelBand = 1

# Sekunder før en mob uden for kamp må skaleres igen til nærmeste spiller.
# 0 = kun én gang ved første syn; kamp-start skalerer altid til modstanderen.
ZoneScaling.RescaleIntervalSec = 0

# Creature entries der aldrig skaleres. Standard: dyrene fra hunter-questen
# "Taming the Beast" (taming rods virker kun op til et fast level).
ZoneScaling.ExcludeCreatureEntries = 1126,1196,1201,1996,1998,2043,2956,2959,2970,3099,3107,3126,15650,15652,16353,17203,17217,17374

#------------------------------------------------------------------------------
# Dungeons og raids
# Normale dungeons låses til ét level pr. run: det højeste level blandt
# spillere/bots i instancen og deres gruppe, plus DungeonLevelOffset.
# Heroic-dungeons og raids beholder deres egne levels.
#------------------------------------------------------------------------------
ZoneScaling.DungeonLevelOffset = 1
ZoneScaling.DungeonBossLevelOffset = 2

# Raid-mobs får ekstra HP/damage/armor pr. medlem i raidet (0.02 = 2%).
ZoneScaling.RaidScalingEnable = 1
ZoneScaling.RaidSizePerPlayerMult = 0.02

#------------------------------------------------------------------------------
# Zoner og areas der skaleres
# Area-indstillinger har forrang over zone-indstillinger.
#------------------------------------------------------------------------------
ZoneScaling.ZoneIds = 1,3,4,8,10,11,12,14,15,16,17,28,33,36,38,40,41,44,45,46,47,51,65,66,67,85,130,139,141,148,215,267,331,357,361,394,400,405,406,440,490,493,495,618,3430,3433,3483,3484,3485,3486,3487,3488,3518,3519,3520,3524,3525,3537,3703,3711,3712,4197,4298,1581,209,717,718,491,719,1337,721,1477,722,1176,1583,1584,2017,2100,2437,2557,2057,2366,206,1196,4196,4265,4264,4272,4277,4416,4417

ZoneScaling.AreaIds = 209,271,465,722,1537,1637,2017,2057,2118,2367,2557,2677,3456,3457,3507,3508,3517,3520,3606,3607,3636,3646,3648,3679,3680,3685,3688,3707,3708,3709,3710,3713,3714,3715,3716,3717,3742,3744,3745,3748,3749,3754,3789,3790,3791,3836,3845,3847,3848,3849,3852,3880,3893,3935,3938,3944,3959,3973,3974,3975,3976,3977,3978,3980,3999,4009,4128,4157,4221,4272,4405,4520

#------------------------------------------------------------------------------
# Tilsidesættelser pr. zone/area
# Mulige nøgler: ZoneScaling.Zone.<id>.X og ZoneScaling.Area.<id>.X, hvor X er
# MinLevel, MaxLevel, LevelOffset, HPPerLevelDiff, DmgPerLevelDiff,
# ArmorPerLevelDiff eller QuestLevelAutoScale. Alle andre zoner bruger
# quest-data og standardværdierne ovenfor.
#------------------------------------------------------------------------------

# Startzoner: level 1-10 (quest-data giver ellers MinLevel 4-5).
